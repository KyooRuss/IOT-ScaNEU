# Copy to .env and adjust. Never commit .env.

# Long random string: python -c "import secrets; print(secrets.token_hex(32))"
SCANEU_SECRET_KEY=change-me

# 127.0.0.1 = this computer only. On the Pi use 0.0.0.0 so guards on the LAN can connect.
SCANEU_HOST=127.0.0.1
SCANEU_PORT=5000
SCANEU_DEBUG=1

# 1 = mock gate + /dev/simulator. Set to 0 on the Pi once the Arduinos are connected.
SCANEU_SIMULATOR=1

# SCANEU_DATABASE=instance/scaneu.db
# SCANEU_IMAGE_DIR=data/images
# SCANEU_BARRIER_CLOSE_DELAY=3
# SCANEU_BARRIER_OPEN_TIMEOUT=15
